# Telegram (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your numeric user id from @userinfobot (comma-separated if multiple)
TELEGRAM_ALLOWED_USER_IDS=

# OpenRouter — use a NORMAL API key from https://openrouter.ai/keys
# NOT a "management key" from /settings/management-keys
OPENROUTER_API_KEY=
# Free-tier friendly default (change anytime)
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# Comma-separated extras tried automatically on 429/500
OPENROUTER_FALLBACK_MODELS=openrouter/free,liquid/lfm-2.5-2.6b:free

# Niche for daily scripts
CONTENT_NICHE=AI tools for creators
CONTENT_LANGUAGE=Hinglish

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

HEDRA_API_KEY=